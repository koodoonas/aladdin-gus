@ECHO OFF
IF "%ULTRASND%"=="" GOTO NOENV
IF NOT EXIST ALADDIN.EXE GOTO NOEXE
IF NOT EXIST ALADGUS.COM GOTO NOTOOL

IF EXIST ALAD_ORG.EXE GOTO EXEBAKOK
COPY ALADDIN.EXE ALAD_ORG.EXE >NUL
IF ERRORLEVEL 1 GOTO FAILED
:EXEBAKOK

IF NOT EXIST SOUND.CFG GOTO CFGBACKED
IF EXIST SND_ORG.CFG GOTO CFGBACKED
COPY SOUND.CFG SND_ORG.CFG >NUL
IF ERRORLEVEL 1 GOTO FAILED
:CFGBACKED

ATTRIB -R ALADDIN.EXE >NUL
IF EXIST SOUND.CFG ATTRIB -R SOUND.CFG >NUL
ALADGUS.COM
IF ERRORLEVEL 1 GOTO FAILED

ECHO.
ECHO Installation complete for ULTRASND=%ULTRASND%
ECHO Keep EMS and XMS enabled, then run ALADDIN.
ECHO Do not run SETSND; use CONFIG.BAT after changing ULTRASND.
GOTO END

:NOENV
ECHO ERROR: ULTRASND is not set.
ECHO Expected format: SET ULTRASND=port,dma1,dma2,irq1,irq2
GOTO END
:NOEXE
ECHO ERROR: Run INSTALL from the installed Aladdin directory.
GOTO END
:NOTOOL
ECHO ERROR: ALADGUS.COM is missing.
GOTO END
:FAILED
ECHO ERROR: Installation failed. Backups were not removed.
ECHO Run RESTORE.BAT if ALADDIN.EXE was partly modified.
:END
