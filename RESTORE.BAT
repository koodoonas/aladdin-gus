@ECHO OFF
IF NOT EXIST ALAD_ORG.EXE GOTO NOEXE

IF EXIST ALADDIN.EXE ATTRIB -R ALADDIN.EXE >NUL
COPY /Y ALAD_ORG.EXE ALADDIN.EXE >NUL
IF ERRORLEVEL 1 GOTO FAILED

IF NOT EXIST SND_ORG.CFG GOTO NOSOUND
IF EXIST SOUND.CFG ATTRIB -R SOUND.CFG >NUL
COPY /Y SND_ORG.CFG SOUND.CFG >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Original ALADDIN.EXE and SOUND.CFG restored.
GOTO END

:NOSOUND
ECHO Original ALADDIN.EXE restored.
ECHO No original SOUND.CFG backup was available.
GOTO END
:NOEXE
ECHO ERROR: ALAD_ORG.EXE backup was not found.
GOTO END
:FAILED
ECHO ERROR: Restore failed. Backup files were not removed.
:END
